# Keep this file server-side only. Never copy these secrets into the Flutter app.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ULTRON_MOBILE_BEARER_TOKEN=replace-with-a-long-random-secret
ULTRON_AGENT_NAME=my-agent
# Enable only after the authenticated desktop bridge is implemented and verified.
ULTRON_COMPANION_ENABLED=0
ULTRON_ALLOWED_ORIGINS=
