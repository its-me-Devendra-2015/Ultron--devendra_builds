{
  "name": "ultron",
  "version": "1.3.3",
  "private": true,
  "description": "ULTRON desktop AI assistant",
  "author": "ULTRON",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "pkg app.js --targets node22-win-x64 --output dist/ULTRON.exe",
    "installer": "electron-builder --win nsis --x64"
  },
  "pkg": { "assets": ["index.html", "apps.json", ".env.example"] },
  "build": {
    "appId": "com.ultron.assistant",
    "productName": "ULTRON",
    "directories": { "output": "dist-installer" },
    "files": ["main.js", "server.js", "index.html", "apps.json", ".env.example", "build/icon.png", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png", "signAndEditExecutable": false },
    "nsis": {
      "script": "installer/ULTRON.nsi",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ULTRON",
      "runAfterFinish": true,
      "artifactName": "ULTRON-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.0"
  }
}
