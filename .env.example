# Copy this file to .env and fill in your keys. Never share or commit .env.
GEMINI_API_KEY=
FISH_API_KEY=
# Fish Audio voice model ID
FISH_VOICE_ID=
# Optional overrides
# TTS_PROVIDER=fish          (fish or elevenlabs; auto-picks fish when its key is set)
# GEMINI_MODEL=gemini-flash-latest
# FISH_MODEL=s2-pro
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Gmail connection (read-only). Create an OAuth client of type "Desktop app" in Google Cloud Console,
# enable the Gmail API, then paste the client ID and secret here. Connect your account in ULTRON Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Search answers use Gemini's Google Search grounding and the GEMINI_API_KEY above.

# ---- OFFLINE MODE (no internet needed after setup) ----
# OFFLINE_MODE=1                    blocks ALL outbound internet calls from the server; AI runs locally via Ollama
# OLLAMA_MODEL=gemma3:4b            text model (any model you pulled)
# OLLAMA_VISION_MODEL=gemma3:4b     model used for screen recognition (must support images)
# OLLAMA_URL=http://127.0.0.1:11434
# Offline voice input via whisper.cpp (optional):
# WHISPER_CMD=C:\whisper\whisper-cli.exe
# WHISPER_MODEL=C:\whisper\ggml-base.en.bin

# ---- Hosting ----
# PORT=4777                       any free port; ULTRON moves to the next one if busy
# HOST=127.0.0.1                  default: this PC only. Use 0.0.0.0 to serve your whole network (REQUIRES a password below)
# ULTRON_PASSWORD=                with HOST=0.0.0.0, open http://<this-pc-ip>:4777/?t=<password> from another device
# WEATHER_LAT=
# WEATHER_LON=                    set these if location lookup doesn't work in the app window

# ---- v2: automatic online/offline switching ----
# AUTO_FALLBACK=1        1 = use the cloud AI when the internet works and switch to the local Gemma model when it does not (set 0 to disable)
# MODE=auto              auto | online | offline (also changeable in Settings > Brain)
# OLLAMA_MODEL=          leave empty to auto-detect an installed Gemma (prefers gemma4:e2b, then e4b, then gemma3)
# WARM_LOCAL=1           preload the local model at start even when online (uses about 2-3 GB RAM)
